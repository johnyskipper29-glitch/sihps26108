# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/standards_db"

# JWT Secret for Authentication
JWT_SECRET_KEY="bis-standards-secret-key-production-engine"

# AI / LLM Configuration
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.8-flash"

# Embedding Model Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Vector Database (ChromaDB)
CHROMA_HOST="localhost"
CHROMA_PORT=8000
TOP_K=10

# Configurable Re-Ranking Weights (Must sum to 1.0)
SEMANTIC_WEIGHT=0.40
PRODUCT_WEIGHT=0.20
CATEGORY_WEIGHT=0.15
APPLICATION_WEIGHT=0.10
TECHNICAL_WEIGHT=0.10
SAFETY_WEIGHT=0.05
